{
  "uid": "openegiz-aktogay-mine",
  "title": "Цифровой рудник «Актогай» (Team AURA)",
  "tags": [
    "openegiz",
    "aktogay",
    "mine",
    "blending",
    "what-if"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "description": "Цифровой двойник карьера Актогай (KAZ Minerals) команды AURA (team-077). Динамическая диспетчеризация, шихтовка руды 0.48% Cu и What-If сценарии.",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Качество руды на дробилке (% Cu)",
      "datasource": {
        "type": "influxdb",
        "uid": "opentwins-influxdb"
      },
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 3,
          "min": 0.2,
          "max": 0.8,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#f87171", "value": null },
              { "color": "#fbbf24", "value": 0.40 },
              { "color": "#10b981", "value": 0.44 },
              { "color": "#fbbf24", "value": 0.52 },
              { "color": "#f87171", "value": 0.56 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "opentwins-influxdb" },
          "query": "from(bucket: \"default\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r.thingId == \"org.openegiz.aktogay:crusher-01\" and r._field == \"value_feed_grade_properties_value\")\n  |> keep(columns: [\"_time\", \"_value\"])"
        }
      ]
    },
